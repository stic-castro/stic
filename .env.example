# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable/anon key. Prefer the publishable key in new Supabase projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backward-compatible alias if your project still shows an anon public key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for admin user creation. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL connection URL used by server-side Next.js code through pg.
DATABASE_URL=
